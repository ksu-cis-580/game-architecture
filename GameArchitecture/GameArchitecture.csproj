<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GameArchitecture: the DesktopGL game client (states, UI, views, audio for this game).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <RootNamespace>GameArchitecture</RootNamespace>

    <MonoGamePlatform>DesktopGL</MonoGamePlatform>
    <ContentBuilderProject>..\GameArchitecture.Content\GameArchitecture.Content.csproj</ContentBuilderProject>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
    <EmbeddedResource Include="Icon.ico" LogicalName="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CIS580\CIS580.Core\CIS580.Core.csproj" />
    <ProjectReference Include="..\CIS580\CIS580.MonoGame\CIS580.MonoGame.csproj" />
    <ProjectReference Include="..\GameArchitecture.Simulation\GameArchitecture.Simulation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
  </ItemGroup>
  <Import Project="..\CIS580\Build\CIS580.Content.targets" />
</Project>
